rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminExists() {
      return exists(/databases/$(database)/documents/settings/admin);
    }

    function isAdmin() {
      return signedIn()
        && adminExists()
        && get(/databases/$(database)/documents/settings/admin).data.uid == request.auth.uid;
    }

    // Public library content: anyone can read, only the claimed admin can write.
    match /videoLibrary/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // First signed-in user claims the admin role once.
    match /settings/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/settings/admin)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }
  }
}
